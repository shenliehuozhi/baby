---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// 1. 使用 Content Collections 获取所有独立的画作数据
const rawArtworks = await getCollection('artworks');

// 2. 智能兜底、年份/月份提取，并按日期倒序排序，同时赋予正确的排序索引
const artworks = rawArtworks.map((entry) => {
  const art = entry.data;
  const yearStr = art.date ? art.date.substring(0, 4) : '2026';
  const monthStr = art.date ? art.date.substring(0, 7) : '2026-01';
  return {
    ...art,
    category: art.category || 'other',
    tags: art.tags || [],
    date: art.date || '2026-01-01',
    year: `${yearStr}年`,
    month: monthStr,
  };
}).sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .map((art, index) => ({
    ...art,
    originalIndex: index // 确保索引与排序后的数组位置严格一致，供灯箱弹窗使用
  }));

// 📊 计算成长统计数据
const totalArtworks = artworks.length;
const uniqueMonths = [...new Set(artworks.map(art => art.month))].length;

// 📅 构建右侧层级时间导航 (Year -> Months)
const yearMap = {};
artworks.forEach(art => {
  const y = art.month.substring(0, 4);
  if (!yearMap[y]) yearMap[y] = new Set();
  yearMap[y].add(art.month);
});

const timelineHierarchy = Object.keys(yearMap).sort().reverse().map(year => ({
  year,
  months: Array.from(yearMap[year]).sort().reverse().map(m => ({
    value: m,
    label: `${m.substring(5, 7)}月`
  }))
}));
---

<Layout title="七叶童画成林 🎨">
  <main class="gallery-container is-grid" id="galleryRoot">
    <!-- 头部标语 -->
    <header class="header">
      <h1>✨ 七叶童画成林 ✨</h1>
      <p>记录童年的异想天开，把每一道色彩变成永恒。</p>
    </header>

    <!-- 📊 成长统计面板 -->
    <section class="stats-panel">
      <div class="stat-card">
        <span class="stat-num">{totalArtworks}</span>
        <span class="stat-label">🎨 收藏画作</span>
      </div>
      <div class="stat-card">
        <span class="stat-num">{uniqueMonths}</span>
        <span class="stat-label">⏳ 记录月份</span>
      </div>
    </section>

    <!-- 🎛️ 左侧悬浮控制与筛选侧边栏 -->
    <div class="control-sidebar" id="controlSidebar">
      <div class="nav-title">🎛️ 视图与分类</div>

      <div class="control-group">
        <div class="nav-subtitle">视图模式</div>
        <div class="view-switcher-sidebar">
          <button class="view-btn active" data-view="grid">🖼️ 网格</button>
          <button class="view-btn" data-view="timeline">⏳ 时间轴</button>
        </div>
      </div>

      <div class="control-group">
        <div class="nav-subtitle">作品分类</div>
        <div class="filter-list-sidebar">
          <button class="filter-btn active" data-filter="all">🌟 全部作品</button>
          <button class="filter-btn" data-filter="creative">🎨 奇思妙想</button>
          <button class="filter-btn" data-filter="nature">🌿 自然风光</button>
          <button class="filter-btn" data-filter="life">🏡 日常点滴</button>
          <button class="filter-btn" data-filter="other">📌 其他作品</button>
        </div>
      </div>
    </div>

    <!-- 📱 移动端顶部显示的备用控制栏 -->
    <div class="mobile-control-bar">
      <div class="view-switcher">
        <button class="view-btn active" data-view="grid">🖼️ 网格</button>
        <button class="view-btn" data-view="timeline">⏳ 时间轴</button>
      </div>
      <div class="filter-bar">
        <div class="filter-scroll">
          <button class="filter-btn active" data-filter="all">🌟 全部</button>
          <button class="filter-btn" data-filter="creative">🎨 奇思</button>
          <button class="filter-btn" data-filter="nature">🌿 自然</button>
          <button class="filter-btn" data-filter="life">🏡 日常</button>
          <button class="filter-btn" data-filter="other">📌 其他</button>
        </div>
      </div>
    </div>

    <!-- 📅 右侧悬浮层级日期导航条 -->
    <div class="date-nav-bar" id="dateNavBar">
      <div class="nav-title">📌 时间导航</div>
      <div class="nav-items-scroll">
        {timelineHierarchy.map(item => (
          <div class="nav-year-group">
            <div class="nav-year-label">{item.year}</div>
            <div class="nav-months-list">
              {item.months.map(m => (
                <button class="nav-item-btn" data-target-month={m.value}>{m.label}</button>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- 🌟 单一数据源渲染容器 -->
    <div class="gallery-content" id="galleryContent">
      <div class="timeline-line"></div>
      {artworks.map((art) => (
        <div class="card-wrapper" data-category={art.category} data-date={art.date} data-month={art.month}>
          <div class="timeline-dot"></div>
          <div class="timeline-date-badge">{art.date}</div>

          <div class="card">
            <div class="image-wrapper" data-index={art.originalIndex} title="点击查看大图与详细故事">
              <img src={art.image} alt={art.title} loading="lazy" />
              <span class="age-badge">{art.year}</span>
              <div class="zoom-tip">🔍 点击查看大图</div>
            </div>

            <div class="card-content">
              <div class="card-header">
                <h2>{art.title}</h2>
                <span class="date">{art.date}</span>
              </div>
              <p class="story">"{art.description}"</p>
              {art.tags.length > 0 && (
                <div class="tags">
                  {art.tags.map(tag => (
                    <span class="tag">#{tag}</span>
                  ))}
                </div>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>

    <footer>
      <p>© {new Date().getFullYear()} - Made with ❤️ for our little artist</p>
    </footer>
  </main>

  <!-- 🔍 全屏沉浸式灯箱 (Lightbox) 弹窗 -->
  <div id="lightbox" class="lightbox-overlay">
    <button class="lightbox-close" title="关闭 (Esc)">&times;</button>
    <button class="lightbox-prev" title="上一张 (←)">&#10094;</button>
    <button class="lightbox-next" title="下一张 (→)">&#10095;</button>

    <div class="lightbox-container" id="lightbox-container">
      <div class="lightbox-img-wrapper" id="lightbox-img-wrapper">
        <img id="lightbox-img" src="" alt="放大图" />
      </div>
      <div class="lightbox-details">
        <div class="lightbox-meta">
          <span id="lightbox-year" class="age-badge-tag"></span>
          <span id="lightbox-date" class="date"></span>
        </div>
        <h2 id="lightbox-title"></h2>
        <p id="lightbox-desc" class="story"></p>

        <div class="lightbox-actions">
          <button id="speak-btn" class="speak-btn" title="点击朗读故事">🔊 朗读故事</button>
          <button id="portraitPosterBtn" class="poster-btn" title="生成竖版电影海报">🎬 竖版海报</button>
          <button id="landscapePosterBtn" class="poster-btn" title="生成横版纪念卡">🖼️ 横版纪念卡</button>
        </div>
      </div>
    </div>
  </div>

  <!-- 🎬 1. 竖版电影海报预览模态框 -->
  <div id="portraitPosterModal" class="poster-modal">
    <div class="portrait-card">
      <div class="poster-header">✨ 七叶童画成林 ✨</div>
      <div class="portrait-img-box">
        <img id="portraitImg" src="" alt="竖版海报" />
      </div>
      <h3 id="portraitTitle"></h3>
      <p id="portraitDesc" class="poster-story"></p>
      <div class="poster-footer">
        <span id="portraitDate"></span>
        <span>电影级艺术珍藏 ❤️</span>
      </div>
    </div>
    <div class="poster-actions">
      <button id="closePortraitBtn" class="poster-close-btn">关闭海报</button>
      <p class="poster-tip">💡 提示：长按保存竖版电影海报</p>
    </div>
  </div>

  <!-- 🖼️ 2. 横版宽屏纪念卡预览模态框 -->
  <div id="landscapePosterModal" class="poster-modal">
    <div class="landscape-card">
      <div class="poster-img-box-wide">
        <img id="landscapeImg" src="" alt="横版纪念卡" />
      </div>
      <div class="poster-info-wide">
        <div class="poster-badge">✨ 七叶童画成林 ✨</div>
        <h3 id="landscapeTitle"></h3>
        <p id="landscapeDesc" class="poster-story"></p>
        <div class="poster-footer">
          <span id="landscapeDate"></span>
          <span>童年的异想天开 ❤️</span>
        </div>
      </div>
    </div>
    <div class="poster-actions">
      <button id="closeLandscapeBtn" class="poster-close-btn">关闭卡片</button>
      <p class="poster-tip">💡 提示：截图或长按保存横版纪念卡</p>
    </div>
  </div>
</Layout>

