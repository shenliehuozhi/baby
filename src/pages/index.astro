    position: absolute;
    bottom: 12px;
    right: 12px;
    background: rgba(0, 0, 0, 0.6);
    color: white;
    font-size: 0.75rem;
    padding: 3px 8px;
    border-radius: 20px;
    backdrop-filter: blur(4px);
  }

