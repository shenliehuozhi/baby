---
import Layout from '../layouts/Layout.astro';
import artworks from '../data/artworks.json';
---

<Layout title="宝宝的线上美术馆 🎨">
  <main class="gallery-container">
    <!-- 头部标语 -->
    <header class="header">
      <h1>✨ 宝宝的小小美术馆 ✨</h1>
      <p>记录童年的异想天开，把每一道色彩变成永恒。</p>
    </header>

    <!-- 画作展厅容器（自动居中排列） -->
    <div class="grid">
      {artworks.map((art, index) => (
        <div class="card">
          <!-- 图片展示区（点击可放大，带 data-index 属性用于定位） -->
          <div class="image-wrapper" data-index={index} title="点击查看大图与详细故事">
            <img src={art.image} alt={art.title} loading="lazy" />
            <span class="age-badge">{art.age}</span>
            <div class="zoom-tip">🔍 点击查看大图</div>
          </div>

          <!-- 文字故事区 -->
          <div class="card-content">
            <div class="card-header">
              <h2>{art.title}</h2>
              <span class="date">{art.date}</span>
            </div>
            <p class="story">"{art.description}"</p>
          </div>
        </div>
      ))}
    </div>

    <!-- 底部版权 -->
    <footer>
      <p>© {new Date().getFullYear()} - Made with ❤️ for our little artist</p>
    </footer>
  </main>

  <!-- 🔍 全屏沉浸式灯箱 (Lightbox) 弹窗 -->
  <div id="lightbox" class="lightbox-overlay">
    <button class="lightbox-close" title="关闭 (Esc)">&times;</button>
    <button class="lightbox-prev" title="上一张 (←)">&#10094;</button>
    <button class="lightbox-next" title="下一张 (→)">&#10095;</button>

    <div class="lightbox-container" id="lightbox-container">
      <!-- 图片展示区 -->
      <div class="lightbox-img-wrapper">
        <img id="lightbox-img" src="" alt="放大图" />
      </div>

      <!-- 详细信息展示区 -->
      <div class="lightbox-details">
        <div class="lightbox-meta">
          <span id="lightbox-age" class="age-badge-tag"></span>
          <span id="lightbox-date" class="date"></span>
        </div>
        <h2 id="lightbox-title"></h2>
        <p id="lightbox-desc" class="story"></p>

        <!-- 🔊 语音朗读按钮 -->
        <button id="speak-btn" class="speak-btn" title="点击朗读故事">
          🔊 朗读故事
        </button>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* 整体页面配置 */
  .gallery-container {
    width: 100%;
    margin: 0 auto;
    padding: 40px 20px;
    background-color: #fffbf5;
    min-height: 100vh;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    box-sizing: border-box;
  }

  .header {
    text-align: center;
    margin-bottom: 40px;
  }

  .header h1 {
    font-size: 2.4rem;
    color: #78350f;
    margin-bottom: 8px;
  }

  .header p {
    color: #b45309;
    font-size: 1rem;
  }

  .grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 30px;
    max-width: 1400px;
    margin: 0 auto;
  }

  .card {
    flex: 1 1 340px;
    max-width: 420px;
    background: white;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
    border: 1px solid #fef3c7;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.08);
  }

  .image-wrapper {
    background: #fdf6e9;
    height: 240px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 12px;
    cursor: zoom-in;
  }

  .image-wrapper img {
    max-height: 100%;
    max-width: 100%;
    object-fit: contain;
    transition: transform 0.3s ease;
  }

  .card:hover .image-wrapper img {
    transform: scale(1.03);
  }

  .zoom-tip {
    position: absolute;
    top: 10px;
    left: 10px;
    background: rgba(0, 0, 0, 0.6);
    color: white;
    font-size: 0.75rem;
    padding: 3px 8px;
    border-radius: 20px;
    opacity: 0;
    transition: opacity 0.3s ease;
    backdrop-filter: blur(4px);
  }

  .image-wrapper:hover .zoom-tip {
    opacity: 1;
  }

  .age-badge {
    position: absolute;
    bottom: 12px;
    right: 12px;
    background: rgba(0, 0, 0, 0.6);
    color: white;
    font-size: 0.75rem;
    padding: 3px 8px;
    border-radius: 20px;
    backdrop-filter: blur(4px);
  }

  .card-content {
    padding: 18px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: 1;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
  }

  .card-header h2 {
    font-size: 1.15rem;
    font-weight: bold;
    color: #1f2937;
    margin: 0;
  }

  .date {
    font-size: 0.8rem;
    color: #9ca3af;
  }

  .story {
    color: #4b5563;
    font-size: 0.875rem;
    line-height: 1.5;
    background: #fffbeb;
    padding: 10px 12px;
    border-radius: 8px;
    border: 1px solid #fef3c7;
    margin: 0;
  }

  footer {
    text-align: center;
    margin-top: 50px;
    color: #b45309;
    font-size: 0.85rem;
  }

  /* ----------------- 💡 响应式 Lightbox 弹窗样式（移动优先） ----------------- */
  .lightbox-overlay {
    display: none;
    position: fixed;
    z-index: 1000;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.92);
    backdrop-filter: blur(8px);
    justify-content: center;
    align-items: center;
    padding: 12px;
    box-sizing: border-box;
  }

  .lightbox-overlay.active {
    display: flex;
  }

  /* 默认（移动端/小屏幕）：上下垂直结构，确保铺满且不挤压 */
  .lightbox-container {
    display: flex;
    flex-direction: column;
    width: 95vw;
    height: 94vh;
    background: #fffbf5;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0,0,0,0.7);
    border: 1px solid #fef3c7;
    position: relative;
  }

  .lightbox-img-wrapper {
    flex: 1.4;
    background: #0d0d0d;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 15px;
    overflow: hidden;
  }

  #lightbox-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: 6px;
  }

  .lightbox-details {
    flex: 1;
    padding: 20px 24px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    overflow-y: auto;
    background: #fff;
  }

  .lightbox-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .lightbox-details .age-badge-tag {
    background: #fef3c7;
    color: #b45309;
    font-size: 0.85rem;
    padding: 4px 10px;
    border-radius: 20px;
    font-weight: 500;
  }

  .lightbox-details .date {
    font-size: 0.85rem;
    color: #9ca3af;
  }

  #lightbox-title {
    font-size: 1.35rem;
    color: #1f2937;
    margin: 0 0 10px 0;
    line-height: 1.3;
  }

  .lightbox-details .story {
    font-size: 1rem;
    line-height: 1.6;
    background: #fffbeb;
    padding: 12px 14px;
    border-radius: 10px;
    border: 1px solid #fef3c7;
    color: #4b5563;
    margin: 0;
  }

  /* 🔊 语音朗读按钮样式 */
  .speak-btn {
    margin-top: 15px;
    background-color: #fef3c7;
    color: #b45309;
    border: 1px solid #fde68a;
    padding: 10px 16px;
    border-radius: 20px;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    transition: all 0.2s ease;
    width: fit-content;
  }

  .speak-btn:hover {
    background-color: #fde68a;
    transform: scale(1.03);
  }

  .speak-btn.playing {
    background-color: #fcd34d;
    animation: pulse 1.5s infinite;
  }

  @keyframes pulse {
    0% { opacity: 1; }
    50% { opacity: 0.6; }
    100% { opacity: 1; }
  }

  /* 关闭与切换控制按钮（移动端适配位置） */
  .lightbox-close, .lightbox-prev, .lightbox-next {
    position: absolute;
    background: rgba(0, 0, 0, 0.5);
    color: white;
    border: none;
    cursor: pointer;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, transform 0.2s;
    backdrop-filter: blur(4px);
    z-index: 1010;
  }

  .lightbox-close:hover, .lightbox-prev:hover, .lightbox-next:hover {
    background: rgba(0, 0, 0, 0.7);
    transform: scale(1.05);
  }

  .lightbox-close {
    top: 15px;
    right: 15px;
    width: 38px;
    height: 38px;
    font-size: 24px;
  }

  .lightbox-prev, .lightbox-next {
    top: 28%; /* 居于上方图片区域的中部 */
    transform: translateY(-50%);
    width: 42px;
    height: 42px;
    font-size: 18px;
  }

  .lightbox-prev { left: 10px; }
  .lightbox-next { right: 10px; }


  /* 🖥️ 电脑端大屏幕（>= 1024px）：恢复左右分栏结构与宽大尺寸 */
  @media (min-width: 1024px) {
    .lightbox-container {
      flex-direction: row;
      width: 92vw;
      height: 92vh;
      border-radius: 20px;
    }

    .lightbox-img-wrapper {
      flex: 4;
      padding: 25px;
    }

    .lightbox-details {
      flex: 1.1;
      min-width: 320px;
      padding: 45px;
      justify-content: center;
    }

    .lightbox-meta {
      margin-bottom: 20px;
    }

    .lightbox-details .age-badge-tag {
      font-size: 0.95rem;
      padding: 6px 14px;
    }

    .lightbox-details .date {
      font-size: 0.95rem;
    }

    #lightbox-title {
      font-size: 2rem;
      margin: 0 0 20px 0;
    }

    .lightbox-details .story {
      font-size: 1.15rem;
      line-height: 1.75;
      padding: 16px 20px;
      border-radius: 12px;
    }

    .speak-btn {
      margin-top: 24px;
      padding: 12px 20px;
      font-size: 1rem;
      border-radius: 25px;
    }

    .lightbox-close {
      top: 25px;
      right: 35px;
      width: 45px;
      height: 45px;
      font-size: 30px;
      background: rgba(255, 255, 255, 0.2);
    }

    .lightbox-prev, .lightbox-next {
      top: 50%;
      width: 55px;
      height: 55px;
      font-size: 24px;
      background: rgba(255, 255, 255, 0.2);
    }

    .lightbox-prev { left: 20px; }
    .lightbox-next { right: 20px; }
  }
</style>

<!-- ⚡ 交互逻辑脚本 -->
<script define:vars={{ artworks }}>
  let currentIndex = 0;

  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img');
  const lightboxTitle = document.getElementById('lightbox-title');
  const lightboxDate = document.getElementById('lightbox-date');
  const lightboxAge = document.getElementById('lightbox-age');
  const lightboxDesc = document.getElementById('lightbox-desc');
  const speakBtn = document.getElementById('speak-btn');

  const wrappers = document.querySelectorAll('.image-wrapper');
  const closeBtn = document.querySelector('.lightbox-close');
  const prevBtn = document.querySelector('.lightbox-prev');
  const nextBtn = document.querySelector('.lightbox-next');

  function stopSpeech() {
    if ('speechSynthesis' in window && window.speechSynthesis.speaking) {
      window.speechSynthesis.cancel();
      speakBtn.classList.remove('playing');
      speakBtn.textContent = '🔊 朗读故事';
    }
  }

  function updateLightbox(index) {
    stopSpeech();
    const art = artworks[index];
    if (!art) return;
    lightboxImg.src = art.image;
    lightboxTitle.textContent = art.title || '无标题';
    lightboxDate.textContent = art.date || '';
    lightboxAge.textContent = art.age || '';
    lightboxDesc.textContent = art.description ? `"${art.description}"` : '';
    currentIndex = index;
  }

  wrappers.forEach(wrapper => {
    wrapper.addEventListener('click', () => {
      const index = parseInt(wrapper.getAttribute('data-index'), 10);
      if (!isNaN(index)) {
        updateLightbox(index);
        lightbox.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
    });
  });

  function closeLightbox() {
    stopSpeech();
    lightbox.classList.remove('active');
    document.body.style.overflow = 'auto';
  }

  closeBtn.addEventListener('click', closeLightbox);

  lightbox.addEventListener('click', (e) => {
    if (e.target === lightbox) {
      closeLightbox();
    }
  });

  function showPrev(e) {
    if (e) e.stopPropagation();
    currentIndex = (currentIndex - 1 + artworks.length) % artworks.length;
    updateLightbox(currentIndex);
  }

  function showNext(e) {
    if (e) e.stopPropagation();
    currentIndex = (currentIndex + 1 + artworks.length) % artworks.length;
    updateLightbox(currentIndex);
  }

  prevBtn.addEventListener('click', showPrev);
  nextBtn.addEventListener('click', showNext);

  document.addEventListener('keydown', (e) => {
    if (lightbox.classList.contains('active')) {
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') showPrev();
      if (e.key === 'ArrowRight') showNext();
    }
  });

  speakBtn.addEventListener('click', () => {
    if (!('speechSynthesis' in window)) {
      alert('您的浏览器暂不支持语音朗读功能');
      return;
    }

    if (window.speechSynthesis.speaking) {
      stopSpeech();
      return;
    }

    const textToSpeak = lightboxDesc.textContent;
    if (!textToSpeak) return;

    const utterance = new SpeechSynthesisUtterance(textToSpeak);
    utterance.lang = 'zh-CN';
    utterance.rate = 0.9;
    utterance.pitch = 1.05;

    utterance.onstart = () => {
      speakBtn.classList.add('playing');
      speakBtn.textContent = '⏹️ 停止朗读';
    };

    utterance.onend = () => {
      speakBtn.classList.remove('playing');
      speakBtn.textContent = '🔊 朗读故事';
    };

    utterance.onerror = () => {
      speakBtn.classList.remove('playing');
      speakBtn.textContent = '🔊 朗读故事';
    };

    window.speechSynthesis.speak(utterance);
  });
</script>
