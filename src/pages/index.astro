</style>

<script define:vars={{ artworks }}>
  let currentIndex = 0;

  const galleryRoot = document.getElementById('galleryRoot');
  const viewBtns = document.querySelectorAll('.view-btn');
  const filterBtns = document.querySelectorAll('.filter-btn');
  const cardWrappers = document.querySelectorAll('.card-wrapper');

  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img');
  const lightboxTitle = document.getElementById('lightbox-title');
  const lightboxDate = document.getElementById('lightbox-date');
  const lightboxYear = document.getElementById('lightbox-year');
  const lightboxDesc = document.getElementById('lightbox-desc');
  const speakBtn = document.getElementById('speak-btn');
  const imgWrapper = document.getElementById('lightbox-img-wrapper');

  const portraitPosterBtn = document.getElementById('portraitPosterBtn');
  const landscapePosterBtn = document.getElementById('landscapePosterBtn');

  const portraitPosterModal = document.getElementById('portraitPosterModal');
  const portraitImg = document.getElementById('portraitImg');
  const portraitTitle = document.getElementById('portraitTitle');
  const portraitDesc = document.getElementById('portraitDesc');
  const portraitDate = document.getElementById('portraitDate');
  const closePortraitBtn = document.getElementById('closePortraitBtn');

  const landscapePosterModal = document.getElementById('landscapePosterModal');
  const landscapeImg = document.getElementById('landscapeImg');
  const landscapeTitle = document.getElementById('landscapeTitle');
  const landscapeDesc = document.getElementById('landscapeDesc');
  const landscapeDate = document.getElementById('landscapeDate');
  const closeLandscapeBtn = document.getElementById('closeLandscapeBtn');

  const wrappers = document.querySelectorAll('.image-wrapper');
  const closeBtn = document.querySelector('.lightbox-close');
  const prevBtn = document.querySelector('.lightbox-prev');
  const nextBtn = document.querySelector('.lightbox-next');

  viewBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const viewType = btn.getAttribute('data-view');
      viewBtns.forEach(b => {
        if (b.getAttribute('data-view') === viewType) {
          b.classList.add('active');
        } else {
          b.classList.remove('active');
        }
      });

      if (viewType === 'grid') {
        galleryRoot.classList.remove('is-timeline');
        galleryRoot.classList.add('is-grid');
      } else {
        galleryRoot.classList.remove('is-grid');
        galleryRoot.classList.add('is-timeline');
      }
    });
  });

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const category = btn.getAttribute('data-filter');
      filterBtns.forEach(b => {
        if (b.getAttribute('data-filter') === category) {
          b.classList.add('active');
        } else {
          b.classList.remove('active');
        }
      });

      cardWrappers.forEach(wrapper => {
        const cardCategory = wrapper.getAttribute('data-category');
        if (category === 'all' || cardCategory === category) {
          wrapper.classList.remove('hidden');
        } else {
          wrapper.classList.add('hidden');
        }
      });
    });
  });

  const navItemBtns = document.querySelectorAll('.nav-item-btn');
  navItemBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetMonth = btn.getAttribute('data-target-month');
      const targetCard = document.querySelector(`.card-wrapper[data-month="${targetMonth}"]`);
      if (targetCard) {
        targetCard.scrollIntoView({
          behavior: 'smooth',
          block: 'center'
        });
        const cardInner = targetCard.querySelector('.card');
        if (cardInner) {
          cardInner.style.transition = 'transform 0.3s ease, box-shadow 0.3s ease';
          cardInner.style.transform = 'scale(1.03)';
          cardInner.style.boxShadow = '0 0 25px rgba(245, 158, 11, 0.5)';
          setTimeout(() => {
            cardInner.style.transform = '';
            cardInner.style.boxShadow = '';
          }, 800);
        }
      }
    });
  });

  function stopSpeech() {
    if ('speechSynthesis' in window && window.speechSynthesis.speaking) {
      window.speechSynthesis.cancel();
      speakBtn.classList.remove('playing');
      speakBtn.textContent = '🔊 朗读故事';
    }
  }

  function updateLightbox(index) {
    stopSpeech();
    const art = artworks[index];
    if (!art) return;
    lightboxImg.src = art.image;
    lightboxTitle.textContent = art.title || '无标题';
    lightboxDate.textContent = art.date || '';
    lightboxYear.textContent = art.year || '';
    lightboxDesc.textContent = art.description ? `"${art.description}"` : '';
    currentIndex = index;
  }

  wrappers.forEach(wrapper => {
    wrapper.addEventListener('click', () => {
      const index = parseInt(wrapper.getAttribute('data-index'), 10);
      if (!isNaN(index)) {
        updateLightbox(index);
        lightbox.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
    });
  });

  function closeLightbox() {
    stopSpeech();
    lightbox.classList.remove('active');
    document.body.style.overflow = 'auto';
  }

  closeBtn.addEventListener('click', closeLightbox);
  lightbox.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  function showPrev(e) {
    if (e) e.stopPropagation();
    currentIndex = (currentIndex - 1 + artworks.length) % artworks.length;
    updateLightbox(currentIndex);
  }

  function showNext(e) {
    if (e) e.stopPropagation();
    currentIndex = (currentIndex + 1 + artworks.length) % artworks.length;
    updateLightbox(currentIndex);
  }

  prevBtn.addEventListener('click', showPrev);
  nextBtn.addEventListener('click', showNext);

  portraitPosterBtn.addEventListener('click', () => {
    const art = artworks[currentIndex];
    if (!art) return;
    portraitImg.src = art.image;
    portraitTitle.textContent = art.title;
    portraitDesc.textContent = art.description ? `"${art.description}"` : '';
    portraitDate.textContent = art.date;
    portraitPosterModal.classList.add('active');
  });

  closePortraitBtn.addEventListener('click', () => {
    portraitPosterModal.classList.remove('active');
  });

  portraitPosterModal.addEventListener('click', (e) => {
    if (e.target === portraitPosterModal) portraitPosterModal.classList.remove('active');
  });

  landscapePosterBtn.addEventListener('click', () => {
    const art = artworks[currentIndex];
    if (!art) return;
    landscapeImg.src = art.image;
    landscapeTitle.textContent = art.title;
    landscapeDesc.textContent = art.description ? `"${art.description}"` : '';
    landscapeDate.textContent = art.date;
    landscapePosterModal.classList.add('active');
  });

  closeLandscapeBtn.addEventListener('click', () => {
    landscapePosterModal.classList.remove('active');
  });

  landscapePosterModal.addEventListener('click', (e) => {
    if (e.target === landscapePosterModal) landscapePosterModal.classList.remove('active');
  });

  let touchStartX = 0;
  let touchEndX = 0;

  imgWrapper.addEventListener('touchstart', (e) => {
    touchStartX = e.changedTouches[0].screenX;
  }, { passive: true });

  imgWrapper.addEventListener('touchend', (e) => {
    touchEndX = e.changedTouches[0].screenX;
    const diff = touchEndX - touchStartX;
    if (Math.abs(diff) > 50) {
      if (diff > 0) showPrev();
      else showNext();
    }
  }, { passive: true });

  document.addEventListener('keydown', (e) => {
    const anyModalActive = portraitPosterModal.classList.contains('active') ||
                           landscapePosterModal.classList.contains('active');
    if (lightbox.classList.contains('active') || anyModalActive) {
      if (e.key === 'Escape') {
        if (portraitPosterModal.classList.contains('active')) portraitPosterModal.classList.remove('active');
        else if (landscapePosterModal.classList.contains('active')) landscapePosterModal.classList.remove('active');
        else closeLightbox();
      }
      if (e.key === 'ArrowLeft' && !anyModalActive) showPrev();
      if (e.key === 'ArrowRight' && !anyModalActive) showNext();
    }
  });

  speakBtn.addEventListener('click', () => {
    if (!('speechSynthesis' in window)) {
      alert('您的浏览器暂不支持语音朗读功能');
      return;
    }
    if (window.speechSynthesis.speaking) {
      stopSpeech();
      return;
    }
    const textToSpeak = lightboxDesc.textContent;
    if (!textToSpeak) return;

    const utterance = new SpeechSynthesisUtterance(textToSpeak);
    utterance.lang = 'zh-CN';
    utterance.rate = 0.9;
    utterance.pitch = 1.05;

    utterance.onstart = () => {
      speakBtn.classList.add('playing');
      speakBtn.textContent = '⏹️ 停止朗读';
    };
    utterance.onend = utterance.onerror = () => {
      speakBtn.classList.remove('playing');
      speakBtn.textContent = '🔊 朗读故事';
    };

    window.speechSynthesis.speak(utterance);
  });
</script>
